\contentsline {subsubsection}{Key Findings}{70}{section*.45}%
\contentsline {paragraph}{(F1) GAPF consistently achieves the highest PDR, with the advantage growing in sparser networks.}{70}{section*.46}%
\contentsline {paragraph}{(F2) GAPF achieves $2$--$3.5\times $ lower energy consumption and $3$--$9\times $ better energy balance than QMIX/QTRAN.}{70}{section*.47}%
\contentsline {paragraph}{(F3) QMIX and QTRAN converge to statistically indistinguishable performance.}{70}{section*.48}%
\contentsline {paragraph}{(F4) QPSOFL collapses at scale; low energy reflects non-delivery.}{70}{section*.49}%
\contentsline {paragraph}{(F5) GAPF is the only algorithm passing all feasibility constraints.}{71}{section*.50}%
