@article{su_q-learning-based_2023,
	title = {A {Q}-{Learning}-{Based} {Routing} {Approach} for {Energy} {Efficient} {Information} {Transmission} in {Wireless} {Sensor} {Network}},
	volume = {20},
	issn = {1932-4537},
	url = {https://ieeexplore.ieee.org/document/9933016},
	doi = {10.1109/TNSM.2022.3218017},
	abstract = {Nowadays, wireless sensor networks have played an important role in many applications. In these applications, a large number of wireless sensors are deployed in an environment to collect information and form network to transmit collected information to the base station or sink. Because wireless sensors have to work for a long period of time without maintenance, the energy consumption of wireless sensors has a great impact on the lifetime of wireless sensor network. To reduce and balance the energy consumption of wireless sensors, many information transmission routing approaches have been proposed. However, most of them do not consider all energy consumption factors of wireless sensors. To this end, an innovative information transmission routing approach based on Q-learning is proposed in this paper, which enables wireless sensors to adaptively select suitable neighboring sensors to achieve energy efficient information transmission in a decentralized manner. Based on the proposed approach, a wireless sensor first collects state and action information of its neighboring sensors, which includes information transmission direction and distance, the remaining energy, the energy consumption for information transmission and information transmission action. Then, all this information is used to update the Q-values of neighboring sensors, so as to enable the wireless sensor to select suitable neighboring sensor to transmit information according to Q-values. From simulation experiments, it can be seen that the proposed approach enables wireless sensors to reduce and balance the energy consumption of wireless sensors and extend the lifetime of the entire wireless sensor network.},
	number = {2},
	urldate = {2024-10-15},
	journal = {IEEE Transactions on Network and Service Management},
	author = {Su, Xing and Ren, Yiting and Cai, Zhi and Liang, Yi and Guo, Limin},
	month = jun,
	year = {2023},
	note = {Conference Name: IEEE Transactions on Network and Service Management},
	keywords = {Wireless communication, Wireless sensor networks, Sensors, Q-learning, Energy consumption, Routing, Wireless sensor network, energy efficiency, Information processing, local information},
	pages = {1949--1961},
	file = {IEEE Xplore Abstract Record:C\:\\Users\\djime\\Zotero\\storage\\6LJL74FZ\\9933016.html:text/html},
}

@inproceedings{thakare_study_2017,
	title = {Study and analysis of {CO2} emission control methods for wireless networks},
	doi = {10.1109/CESYS.2017.8321181},
	abstract = {Due to increasing use of mobile communications, there is problem of controlling the emissions of CO2 in many countries, especially the countries like India in which large population. Therefore for Information and Communications Technology (ICT) industries needs the methods to minimize the energy consumption of wireless mobile devices. And hence reduction in CO2 emission is minimized. The energy consumption is directly related to CO2 emission, more energy consumed more the CO2 emission. To control the CO2 emissions, there is different research projects already designed and still work is going on. In this paper, our objective is to discuss the recent methods of CO2 emission control for wireless networks such as WSNs (Wireless Sensor Networks) and (WANs) Wireless Access Networks and so on. Green Communications is perspective of CO2 emission in which major energy consumption reduction is expected by designing the energy optimisation metrics as well as combining the energy ware networks and radios. This paper presents the discussion on all energy efficient projects presented.},
	booktitle = {2017 2nd {International} {Conference} on {Communication} and {Electronics} {Systems} ({ICCES})},
	author = {Thakare, Punam and Ambudkar, Bhavna},
	month = oct,
	year = {2017},
	keywords = {Routing, Air pollution, Cellular phones, CO2 Emission, Companies, Earth, EARTH, Efficiency, Energy Consumption, GreenTouch, ICT, Instruments, Wireless networks, Wireless Networks},
	pages = {742--745},
