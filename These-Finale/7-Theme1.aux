\@writefile{toc}{\contentsline {subsubsection}{Key Findings}{70}{section*.45}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{(F1) GAPF consistently achieves the highest PDR, with the advantage growing in sparser networks.}{70}{section*.46}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{(F2) GAPF achieves $2$--$3.5\times $ lower energy consumption and $3$--$9\times $ better energy balance than QMIX/QTRAN.}{70}{section*.47}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{(F3) QMIX and QTRAN converge to statistically indistinguishable performance.}{70}{section*.48}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{(F4) QPSOFL collapses at scale; low energy reflects non-delivery.}{70}{section*.49}\protected@file@percent }
\citation{kraemer2016multi,lowe2017multi}
\@writefile{toc}{\contentsline {paragraph}{(F5) GAPF is the only algorithm passing all feasibility constraints.}{71}{section*.50}\protected@file@percent }
