\contentsline {table}{\numberline {6.6}{\ignorespaces Main security results under \textsc {high}-severity identity-credential abuse (mean $\pm $ std over 20 seeds, 2{,}420 total runs). Block\% = fraction of all decisions that are \textsc {block}; Scope-Red\% = \textsc {scope-reduce}; Allow\% = \textsc {allow}. RogueDet = fraction of ground-truth rogue actions detected; RogueBlk = fraction of rogue actions blocked; FalseBlk = fraction of block decisions targeting legitimate actions; $\omega _{\mathrm {rec}}$ = operational recovery quality. CASTER-ZT achieves effective rogue detection (74.2\%) with zero false positives through intelligent scope-reduction; rogue actions are detected and scope-reduced rather than hard-blocked.}}{167}{table.caption.111}%
\contentsline {table}{\numberline {6.7}{\ignorespaces Cross-method security comparison under \textsc {high}-severity combined attack (mean $\pm $ std, 20 seeds). RogueDet = rogue detection rate; FalseBlk = false block rate; $\omega _{\mathrm {rec}}$ = operational recovery quality. CASTER-ZT vs.\ baseline pairwise Wilcoxon signed-rank tests: $p < 0.001$ on FalseBlk for Shield-Binary, Agentic-Auto; $p < 0.001$ on $\omega _{\mathrm {rec}}$ for CPO-Soft, Agentic-Auto, Trust-Implicit; $\omega _{\mathrm {rec}}$ vs.\ Shield-Binary is not significant ($p = 0.898$); IF-Trust achieves significantly higher $\omega _{\mathrm {rec}}$ ($p < 0.001$) through aggressive scope-reduction.}}{167}{table.caption.113}%
\contentsline {table}{\numberline {6.8}{\ignorespaces Operational recovery quality $\omega _{\mathrm {rec}}$ under \textsc {high}-severity identity-credential abuse (mean $\pm $ std, 20 seeds). Higher is better. $p$-value: Wilcoxon signed-rank vs.\ CASTER-ZT.}}{168}{table.caption.116}%
\contentsline {table}{\numberline {6.9}{\ignorespaces Ablation study under \textsc {high}-severity identity-credential abuse (20 seeds). RogueDet = rogue detection rate; RogueBlk = rogue blocking rate; FalseBlk = false block rate; $\omega _{\mathrm {rec}}$ = operational recovery quality.}}{169}{table.caption.118}%
\contentsline {table}{\numberline {6.10}{\ignorespaces CASTER-ZT results across severity levels (mean over 20 seeds). RogueDet = rogue detection rate; $\omega _{\mathrm {rec}}$ = operational recovery quality.}}{169}{table.caption.121}%
\contentsline {table}{\numberline {6.11}{\ignorespaces Multi-scale evaluation under \textsc {high}-severity identity abuse (mean $\pm $ std, 7 seeds for 36/100-cell, 20 seeds for 12-cell). RogueDet = rogue detection rate; $\omega _{\mathrm {rec}}$ = recovery quality.}}{169}{table.caption.123}%
\contentsline {table}{\numberline {6.12}{\ignorespaces Threshold sensitivity: sweeping $\gamma _1$ under \textsc {high}-severity identity abuse (12-cell, 20 seeds per setting). RogueDet = rogue detection rate. FalseBlk\% = fraction of blocks that are false positives.}}{171}{table.caption.126}%
