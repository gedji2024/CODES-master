	note = {Conference Name: IEEE Sensors Journal},
	keywords = {Wireless sensor networks, Sensors, Energy consumption, Routing, Routing protocols, wireless sensor networks (WSNs), Clustering algorithms, \%{\textbackslash}boldsymbol Clustering routing protocol, cluster head selection, Head, multi-threshold segmentation, network energy consumption},
	pages = {6216--6231},
