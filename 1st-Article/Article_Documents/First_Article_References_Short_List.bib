	month = jan,
	year = {2020},
	note = {Number: 9
Publisher: Multidisciplinary Digital Publishing Institute},
	keywords = {disaster management, energy-efficient clustering and routing, evolutionary algorithms, forest fire, IoT networks, non-uniform distribution of events, tree encoding},
