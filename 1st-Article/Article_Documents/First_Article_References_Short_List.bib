	file = {Full Text PDF:C\:\\Users\\djime\\Zotero\\storage\\WI3BVUMC\\Biabani et al. - 2020 - An Energy-Efficient Evolutionary Clustering Technique for Disaster Management in IoT Networks.pdf:application/pdf},
