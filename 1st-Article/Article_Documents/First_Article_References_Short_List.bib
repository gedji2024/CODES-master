@misc{garcia_camargo_gnn_scheduling_2025,
	title = {Wireless Link Scheduling with State-Augmented Graph Neural Networks},
	url = {https://arxiv.org/abs/2505.07598},
	doi = {10.48550/arXiv.2505.07598},
	abstract = {We consider the problem of optimal link scheduling in large-scale wireless ad hoc networks. With a graph structure representing link conflicts, we formulate a constrained optimisation problem and parameterise the scheduling policy with a graph neural network (GNN). Using state-augmentation with Lagrangian dual variables as dynamic inputs, the GNN adapts scheduling decisions to achieve minimum transmission requirements.},
	author = {Garcia Camargo, Romina and Wang, Zhiyang and NaderiAlizadeh, Navid and Ribeiro, Alejandro},
	month = may,
	year = {2025},
	note = {arXiv:2505.07598 [eess.SP]},
	keywords = {Signal Processing, Graph Neural Networks, Wireless Networks},
}


