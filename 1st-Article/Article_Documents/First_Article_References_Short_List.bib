@article{hosseinzadeh_hybrid_2022,
	title = {A {Hybrid} {Delay} {Aware} {Clustered} {Routing} {Approach} {Using} {Aquila} {Optimizer} and {Firefly} {Algorithm} in {Internet} of {Things}},
	volume = {10},
