	url = {https://arxiv.org/abs/2602.17038},
	doi = {10.48550/arXiv.2602.17038},
	abstract = {We propose Phase-Aware Mixture of Experts (PA-MoE) for reinforcement learning. PA-MoE features a lightweight phase router that learns latent phase boundaries directly from the RL objective, allocating temporally consistent assignments to the same expert so that experts preserve phase-specific expertise, overcoming the simplicity bias of single-policy networks.},
